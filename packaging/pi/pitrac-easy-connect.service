[Unit]
Description=PiTrac Easy Connect
Documentation=https://github.com/PiTracLM/PiTrac
# NetworkManager is what this service drives, so it must be up first.
#
# Not network-online.target. That waits up to a minute for a network, and in a
# house this enclosure has never been in there is not going to be one until this
# service puts up the hotspot to ask for it. The service waits for the radio
# itself, long enough not to give up on a saved network too early, and it goes
# on answering while it does.
After=network.target NetworkManager.service avahi-daemon.service
Wants=NetworkManager.service

# The backoff the [Service] section refers to. These are only honoured here.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m pitrac_easy_connect.pi.app \
    --state-dir /var/lib/pitrac-easy-connect \
    --pitrac-config-dir __PITRAC_CONFIG_DIR__ \
    --portal-port 80 __HOSTNAME_FLAG__
Environment=PYTHONPATH=/usr/lib/pitrac-easy-connect
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/var/lib/pitrac-easy-connect

# This service reconfigures Wi-Fi, sets the hostname, and halts the machine, so
# it runs as root. Everything below narrows what that root can reach. The
# browser-facing code has no route that executes a command; see pi/portal.py.
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=true
# ProtectSystem makes /usr read-only, which is what we want everywhere except
# the one directory this service replaces when it updates itself. Without this
# the update fails at the moment it tries to swap the new copy in, and only on
# a real Pi -- a test that writes to a temporary directory never sees it.
ReadWritePaths=/usr/lib/pitrac-easy-connect
# Versioned releases live here and the symlink above points into them,
# so a self-update writes here rather than into the symlink itself.
ReadWritePaths=/usr/lib/pitrac-easy-connect-releases
# The update guard, which has to survive the release it is guarding against.
# Restarting this service ends the process performing the update, so the
# component that decides whether the new release works, and puts the old one
# back if it does not, cannot live inside either path above. The leading "-"
# keeps an older installation that has no such directory yet from failing to
# start at all.
ReadWritePaths=-/usr/lib/pitrac-easy-connect-guard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

# Restart on failure, but back off rather than spinning, so a persistent crash
# does not keep the radio flapping. The rate limit itself lives in [Unit];
# systemd ignores StartLimit* here, so having them in this section meant the
# service would have restarted forever every five seconds.
Restart=always
RestartSec=5

# Bounded logging. This runs on a microSD card that must survive years of it.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pitrac-easy-connect

[Install]
WantedBy=multi-user.target
